---
import Layout from "./Layout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import SidebarNav from "../components/ui/SidebarNav.astro";

interface Props {
  title: string;
  description?: string;
  section: string;
}

const { title, description, section } = Astro.props;
const pathname = Astro.url.pathname;
---

<Layout title={title} description={description}>
  <PageHeader title={title} pathname={pathname} />
  <div class="mx-auto max-w-7xl px-6 py-10">
    <div class="flex gap-12">
      <!-- Main content -->
      <main class="min-w-0 flex-1 rounded-xl bg-gray-50 p-8 shadow-sm">
        <article class="prose prose-light max-w-none">
          <slot />
        </article>
      </main>

      <!-- Sidebar -->
      <aside class="hidden w-[280px] shrink-0 lg:block">
        <SidebarNav section={section} currentPath={pathname} />
      </aside>
    </div>
  </div>
</Layout>

<style>
  /* Prose styles for light panel */
  .prose :global(h2) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-gold-700);
  }
  .prose :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: #0b3123;
  }
  .prose :global(p) {
    margin-bottom: 1rem;
    line-height: 1.85;
    color: #3c4946;
  }
  .prose :global(ul), .prose :global(ol) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    color: #3c4946;
  }
  .prose :global(li) {
    margin-bottom: 0.25rem;
    line-height: 1.85;
  }
  .prose :global(ul) {
    list-style-type: disc;
  }
  .prose :global(ol) {
    list-style-type: decimal;
  }
  .prose :global(li::marker) {
    color: var(--color-gold-600);
  }
  .prose :global(strong) {
    font-weight: 700;
    color: #1a2120;
  }
  .prose :global(blockquote) {
    margin: 1.5rem 0;
    border-left: 4px solid var(--color-gold-600);
    padding: 0.75rem 1.25rem;
    background-color: rgba(212, 175, 55, 0.08);
    color: #3c4946;
    border-radius: 0 0.75rem 0.75rem 0;
    font-style: italic;
  }
  .prose :global(img) {
    margin: 1.5rem 0;
    border-radius: 0.75rem;
    max-width: 100%;
  }
</style>
