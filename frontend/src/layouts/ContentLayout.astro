---
import Layout from "./Layout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import SidebarNav from "../components/ui/SidebarNav.astro";

interface Props {
  title: string;
  description?: string;
  section: string;
}

const { title, description, section } = Astro.props;
const pathname = Astro.url.pathname;
---

<Layout title={title} description={description}>
  <PageHeader title={title} pathname={pathname} />
  <div class="mx-auto max-w-7xl px-6 py-10">
    <div class="flex gap-12">
      <!-- Main content -->
      <main class="min-w-0 flex-1 rounded-xl bg-gray-50 p-8 shadow-sm">
        <article class="prose prose-light max-w-none">
          <slot />
        </article>
      </main>

      <!-- Sidebar -->
      <aside class="hidden w-[280px] shrink-0 lg:block">
        <SidebarNav section={section} currentPath={pathname} />
      </aside>
    </div>
  </div>
</Layout>
