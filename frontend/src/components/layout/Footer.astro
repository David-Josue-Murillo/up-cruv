---
const year = new Date().getFullYear();
---

<footer class="relative border-t border-gold-500/20 bg-green-950">
  <!-- Subtle pattern overlay -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.03]" style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M30 5 L55 30 L30 55 L5 30Z' fill='none' stroke='%23d4af37' stroke-width='0.5'/%3E%3Cpath d='M30 15 L45 30 L30 45 L15 30Z' fill='none' stroke='%23d4af37' stroke-width='0.3'/%3E%3C/svg%3E&quot;); background-size: 60px 60px;" />

  <div class="relative mx-auto max-w-6xl px-6 py-12">
    <div class="grid gap-8 md:grid-cols-4">
      <!-- Col 1: CRUV Info -->
      <div>
        <h4 class="font-heading text-lg font-bold text-gold-400">CRUV</h4>
        <p class="mt-3 text-sm text-white/60">
          Universidad de Panamá<br />
          Centro Regional Universitario de Veraguas
        </p>
        <p class="mt-3 text-sm text-white/60">
          Calle Décima, vía San Francisco<br />
          Santiago, Veraguas<br />
          (507) 935-1766 / 935-1767
        </p>
      </div>
      <!-- Col 2: Académico -->
      <div>
        <h4 class="text-lg font-bold text-white">Académico</h4>
        <ul class="mt-3 space-y-2 text-sm text-white/50">
          <li><a href="/oferta-academica" class="transition-colors hover:text-gold-400">Oferta Académica</a></li>
          <li><a href="/admision" class="transition-colors hover:text-gold-400">Admisión</a></li>
          <li><a href="/estudiantes/calendario-academico" class="transition-colors hover:text-gold-400">Calendario</a></li>
          <li><a href="/estudiantes/horarios" class="transition-colors hover:text-gold-400">Horarios</a></li>
          <li><a href="/investigacion" class="transition-colors hover:text-gold-400">Investigación</a></li>
        </ul>
      </div>
      <!-- Col 3: Comunidad -->
      <div>
        <h4 class="text-lg font-bold text-white">Comunidad</h4>
        <ul class="mt-3 space-y-2 text-sm text-white/50">
          <li><a href="/noticias" class="transition-colors hover:text-gold-400">Noticias</a></li>
          <li><a href="/eventos" class="transition-colors hover:text-gold-400">Eventos</a></li>
          <li><a href="/extension" class="transition-colors hover:text-gold-400">Extensión</a></li>
          <li><a href="/mediateca" class="transition-colors hover:text-gold-400">Mediateca</a></li>
          <li><a href="/contacto" class="transition-colors hover:text-gold-400">Contacto</a></li>
        </ul>
      </div>
      <!-- Col 4: Institucional -->
      <div>
        <h4 class="text-lg font-bold text-white">Institucional</h4>
        <ul class="mt-3 space-y-2 text-sm text-white/50">
          <li><a href="/nosotros" class="transition-colors hover:text-gold-400">Nosotros</a></li>
          <li><a href="/nosotros/transparencia" class="transition-colors hover:text-gold-400">Transparencia</a></li>
          <li><a href="/politica-privacidad" class="transition-colors hover:text-gold-400">Política de Privacidad</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="relative border-t border-white/10 py-4 text-center text-xs text-white/50">
    <div class="absolute top-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-gold-500/30 to-transparent" />
    &copy; {year} Universidad de Panam&aacute; &mdash; CRUV. Todos los derechos reservados. By David Murillo & Salma Vasquez
  </div>
</footer>
