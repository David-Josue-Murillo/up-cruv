---
import NavbarLogo from "./NavbarLogo.astro";
import SearchButton from "./SearchButton.astro";
import MegaMenu from "./MegaMenu";
import { MobileMenuButton } from "./MobileMenu";

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
const pathname = Astro.url.pathname;
---

<header
  class={transparent
    ? "absolute top-0 left-0 right-0 z-50 px-6"
    : "sticky top-0 z-50"}
>
  <!-- Glassmorphism navbar -->
  <div class="glass mx-auto max-w-7xl rounded-b-2xl px-6">
    <div class="flex items-center justify-between">
      <NavbarLogo transparent={transparent} />

      <!-- Desktop mega-menu -->
      <MegaMenu client:load currentPath={pathname} />

      <!-- Right actions -->
      <div class="hidden items-center gap-2 lg:flex">
        <SearchButton transparent={transparent} />
      </div>
    </div>
  </div>

  <!-- Mobile menu button - Positioned outside glass to avoid clipping -->
  <div class="absolute right-6 top-3 lg:hidden">
    <MobileMenuButton client:idle />
  </div>

  <!-- Gold accent stripe (bottom) -->
  <div
    class="h-[2px] bg-linear-to-r from-transparent via-gold-500 to-transparent shadow-[0_0_12px_rgba(212,175,55,0.4)]"
  >
  </div>
</header>
