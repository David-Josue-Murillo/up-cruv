---
import NavbarLogo from "./NavbarLogo.astro";
import SearchButton from "./SearchButton.astro";
import MegaMenu from "./MegaMenu";
import { MobileMenuButton } from "./MobileMenu";

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
const pathname = Astro.url.pathname;
---

<header class={transparent ? "absolute top-0 left-0 right-0 z-50" : "sticky top-0 z-50"}>

  <!-- Glassmorphism navbar -->
  <div class="glass">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6">
      <NavbarLogo transparent={transparent} />

      <!-- Desktop mega-menu -->
      <MegaMenu client:load currentPath={pathname} transparent={transparent} />

      <!-- Right actions -->
      <div class="hidden items-center gap-2 lg:flex">
        <SearchButton transparent={transparent} />
      </div>

      <!-- Mobile menu button -->
      <MobileMenuButton client:idle transparent={transparent} />
    </div>
  </div>

  <!-- Gold accent stripe (bottom) -->
  <div class="h-[2px] bg-linear-to-r from-transparent via-gold-500 to-transparent shadow-[0_0_12px_rgba(212,175,55,0.4)]" />
</header>

<style>
  @keyframes fadeSlideIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
