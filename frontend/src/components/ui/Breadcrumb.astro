---
import { getBreadcrumbs } from "../../lib/navigation";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const crumbs = getBreadcrumbs(pathname);
---

<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex flex-wrap items-center gap-1.5">
    {crumbs.map((crumb, i) => {
      const isLast = i === crumbs.length - 1;
      return (
        <li class="flex items-center gap-1.5">
          {i > 0 && (
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="h-3 w-3 text-white/50">
              <path fill-rule="evenodd" d="M6.22 4.22a.75.75 0 0 1 1.06 0l3.25 3.25a.75.75 0 0 1 0 1.06l-3.25 3.25a.75.75 0 0 1-1.06-1.06L8.94 8 6.22 5.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
            </svg>
          )}
          {isLast ? (
            <span class="font-medium text-gold-400">{crumb.label}</span>
          ) : (
            <a href={crumb.href} class="text-white/60 transition-colors hover:text-gold-400">
              {crumb.label}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
