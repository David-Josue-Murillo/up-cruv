---
import type { EventItem as EventItemType } from "../../lib/data/events";
import EventItem from "./EventItem.astro";

interface Props {
  events: EventItemType[];
}

const { events } = Astro.props;

// Limitar a máximo 4 eventos
const displayEvents = events.slice(0, 4);
---

<div
  class="flex flex-col gap-6 rounded-3xl border border-gray-100 bg-gray-50/50 p-6 md:p-6"
>
  <div
    class="flex items-center justify-between border-b border-gray-200/60 pb-4"
  >
    <h3
      class="font-heading text-xl font-bold text-gray-900 flex items-center gap-2"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-green-700"
      >
        <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line
          x1="16"
          y1="2"
          x2="16"
          y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line
          x1="3"
          y1="10"
          x2="21"
          y2="10"></line>
      </svg>
      Próximos Eventos
    </h3>
    <a
      href="/eventos"
      class="text-xs font-bold text-green-700 hover:text-green-800 transition-colors"
    >
      Ver todo
    </a>
  </div>

  <div class="flex flex-col gap-4">
    {
      displayEvents.length > 0 ? (
        displayEvents.map((event) => <EventItem event={event} />)
      ) : (
        <p class="text-sm text-gray-500 py-4 text-center italic">
          No hay eventos próximos.
        </p>
      )
    }
  </div>

  <div class="mt-2 text-center border-t border-gray-200/60 pt-4">
    <button
      class="w-full rounded-xl bg-white border border-gray-200 py-3 text-sm font-bold text-gray-700 transition-all hover:bg-green-50 hover:text-green-800 hover:border-green-100 shadow-sm"
    >
      Suscribirse al calendario
    </button>
  </div>
</div>
