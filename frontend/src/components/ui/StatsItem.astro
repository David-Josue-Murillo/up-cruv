---
interface Props {
  number: string;
  label: string;
  sublabel?: string;
}

const { number, label, sublabel } = Astro.props;
---

<div class="flex flex-col items-center text-center group">
  <!-- Circular Icon Container -->
  <div
    class="flex h-16 w-16 items-center justify-center rounded-full bg-green-50 text-green-700 ring-1 ring-green-100 transition-all duration-500 group-hover:bg-gold-500 group-hover:text-green-950 group-hover:ring-gold-400 group-hover:shadow-[0_0_30px_rgba(212,175,55,0.3)]"
  >
    <slot name="icon" />
  </div>

  <!-- Big Number -->
  <p
    class="font-heading text-md font-bold text-green-900 md:text-xl tracking-tight transition-transform duration-500 group-hover:scale-110"
  >
    {number}
  </p>

  <!-- Label -->
  <h4 class="mt-2 text-base font-bold text-gray-800 tracking-wide uppercase">
    {label}
  </h4>

  <!-- Optional Sublabel -->
  {
    sublabel && (
      <p class="mt-1 text-xs font-medium text-gray-500 leading-relaxed max-w-[150px]">
        {sublabel}
      </p>
    )
  }
</div>
