---
import SectionLayout from "../../layouts/SectionLayout.astro";
import { sectionMeta } from "../../lib/navigation";

const meta = sectionMeta["oferta-academica"];
---

<SectionLayout title={meta.title} description={meta.description}>
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    <a href="/oferta-academica/pregrado" class="group light-card p-6">
      <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-gold-100 text-gold-600">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
          <path d="M10.75 16.82A7.462 7.462 0 0 1 15 15.5c.71 0 1.396.098 2.046.282A.75.75 0 0 0 18 15.06v-11a.75.75 0 0 0-.546-.721A9.006 9.006 0 0 0 15 3a8.963 8.963 0 0 0-4.25 1.065V16.82ZM9.25 4.065A8.963 8.963 0 0 0 5 3c-.85 0-1.673.118-2.454.339A.75.75 0 0 0 2 4.06v11a.75.75 0 0 0 .954.721A7.506 7.506 0 0 1 5 15.5a7.462 7.462 0 0 1 4.25 1.32V4.065Z" />
        </svg>
      </div>
      <h3 class="font-bold text-green-900 group-hover:text-gold-700">Pregrado</h3>
      <p class="mt-1 text-sm text-gray-500">Licenciaturas y carreras de grado en diversas áreas del conocimiento.</p>
      <span class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-gold-700">
        Ver programas
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="h-3 w-3"><path fill-rule="evenodd" d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z" clip-rule="evenodd" /></svg>
      </span>
    </a>

    <a href="/oferta-academica/postgrado" class="group light-card p-6">
      <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-gold-100 text-gold-600">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
          <path fill-rule="evenodd" d="M10 1c-1.716 0-3.408.106-5.07.31C3.806 1.45 3 2.414 3 3.517V16.75A2.25 2.25 0 0 0 5.25 19h9.5A2.25 2.25 0 0 0 17 16.75V3.517c0-1.103-.806-2.068-1.93-2.207A41.403 41.403 0 0 0 10 1ZM5.99 8.75A.75.75 0 0 1 6.74 8h.01a.75.75 0 0 1 .75.75v.01a.75.75 0 0 1-.75.75h-.01a.75.75 0 0 1-.75-.75v-.01Zm.75 1.417a.75.75 0 0 0-.75.75v.01c0 .414.336.75.75.75h.01a.75.75 0 0 0 .75-.75v-.01a.75.75 0 0 0-.75-.75h-.01Zm2.42-1.417a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 1-.75-.75Zm.75 1.417a.75.75 0 0 0 0 1.5h2.5a.75.75 0 0 0 0-1.5h-2.5Z" clip-rule="evenodd" />
        </svg>
      </div>
      <h3 class="font-bold text-green-900 group-hover:text-gold-700">Postgrado</h3>
      <p class="mt-1 text-sm text-gray-500">Maestrías y especializaciones para profesionales en ejercicio.</p>
      <span class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-gold-700">
        Ver programas
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="h-3 w-3"><path fill-rule="evenodd" d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z" clip-rule="evenodd" /></svg>
      </span>
    </a>

    <a href="/oferta-academica/tecnico" class="group light-card p-6">
      <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-gold-100 text-gold-600">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
          <path fill-rule="evenodd" d="M8.157 2.175a1.5 1.5 0 0 0-1.147 0l-4.084 1.69A1.5 1.5 0 0 0 2 5.251v10.877a.75.75 0 0 0 1.074.676l3.51-1.69 2.259 1.09a1.5 1.5 0 0 0 1.147 0l2.258-1.09 3.51 1.69a.75.75 0 0 0 1.074-.676V5.251a1.5 1.5 0 0 0-.926-1.386l-4.084-1.69a1.5 1.5 0 0 0-1.147 0l-2.258 1.09-2.26-1.09Z" clip-rule="evenodd" />
        </svg>
      </div>
      <h3 class="font-bold text-green-900 group-hover:text-gold-700">Técnico</h3>
      <p class="mt-1 text-sm text-gray-500">Programas técnicos con formación práctica y rápida inserción laboral.</p>
      <span class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-gold-700">
        Ver programas
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="h-3 w-3"><path fill-rule="evenodd" d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z" clip-rule="evenodd" /></svg>
      </span>
    </a>

    <a href="/oferta-academica/educacion-continua" class="group light-card p-6">
      <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-gold-100 text-gold-600">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
          <path d="M15.98 1.804a1 1 0 0 0-1.96 0l-.24 1.192a1 1 0 0 1-.784.785l-1.192.238a1 1 0 0 0 0 1.962l1.192.238a1 1 0 0 1 .785.785l.238 1.192a1 1 0 0 0 1.962 0l.238-1.192a1 1 0 0 1 .785-.785l1.192-.238a1 1 0 0 0 0-1.962l-1.192-.238a1 1 0 0 1-.785-.785l-.238-1.192ZM6.949 5.684a1 1 0 0 0-1.898 0l-.683 2.051a1 1 0 0 1-.633.633l-2.051.683a1 1 0 0 0 0 1.898l2.051.684a1 1 0 0 1 .633.632l.683 2.051a1 1 0 0 0 1.898 0l.683-2.051a1 1 0 0 1 .633-.633l2.051-.683a1 1 0 0 0 0-1.898l-2.051-.683a1 1 0 0 1-.633-.633L6.95 5.684Z" />
        </svg>
      </div>
      <h3 class="font-bold text-green-900 group-hover:text-gold-700">Educación Continua</h3>
      <p class="mt-1 text-sm text-gray-500">Diplomados, seminarios y cursos de actualización profesional.</p>
      <span class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-gold-700">
        Ver opciones
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="h-3 w-3"><path fill-rule="evenodd" d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z" clip-rule="evenodd" /></svg>
      </span>
    </a>

    <a href="/oferta-academica/facultades" class="group light-card p-6">
      <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-gold-100 text-gold-600">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
          <path fill-rule="evenodd" d="M9.674 2.075a.75.75 0 0 1 .652 0l7.25 3.5A.75.75 0 0 1 17.5 6.5v.518c-.11.06-.218.127-.32.2A2.49 2.49 0 0 0 16 9.5v.054A4.998 4.998 0 0 0 11 14.5v.462a7.502 7.502 0 0 0-1.002 3.416.75.75 0 0 1-1.496 0A7.502 7.502 0 0 0 7.5 15.134V14.5A4.998 4.998 0 0 0 2.5 9.554V9.5A2.49 2.49 0 0 0 1.32 7.218 3.219 3.219 0 0 1 1 7.018V6.5a.75.75 0 0 1-.076-.948l.076-.077 7.25-3.5Z" clip-rule="evenodd" />
        </svg>
      </div>
      <h3 class="font-bold text-green-900 group-hover:text-gold-700">Facultades</h3>
      <p class="mt-1 text-sm text-gray-500">Facultades de la Universidad de Panamá con presencia en el CRUV.</p>
      <span class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-gold-700">
        Ver facultades
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="h-3 w-3"><path fill-rule="evenodd" d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z" clip-rule="evenodd" /></svg>
      </span>
    </a>
  </div>
</SectionLayout>
