---
import SectionLayout from "../../layouts/SectionLayout.astro";
import { sectionMeta } from "../../lib/navigation";

const meta = sectionMeta["nosotros"];
---

<SectionLayout title={meta.title} description={meta.description}>
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    <a href="/nosotros/historia" class="group light-card p-6">
      <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-gold-100 text-gold-600">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
          <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 0 0 0-1.5h-3.25V5Z" clip-rule="evenodd" />
        </svg>
      </div>
      <h3 class="font-bold text-green-900 group-hover:text-gold-700">Historia</h3>
      <p class="mt-1 text-sm text-gray-500">Orígenes, misión y visión del CRUV desde su fundación.</p>
      <span class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-gold-700">
        Ver más
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="h-3 w-3"><path fill-rule="evenodd" d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z" clip-rule="evenodd" /></svg>
      </span>
    </a>

    <a href="/nosotros/autoridades" class="group light-card p-6">
      <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-gold-100 text-gold-600">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
          <path d="M10 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM3.465 14.493a1.23 1.23 0 0 0 .41 1.412A9.957 9.957 0 0 0 10 18c2.31 0 4.438-.784 6.131-2.1.43-.333.604-.903.408-1.41a7.002 7.002 0 0 0-13.074.003Z" />
        </svg>
      </div>
      <h3 class="font-bold text-green-900 group-hover:text-gold-700">Autoridades</h3>
      <p class="mt-1 text-sm text-gray-500">Directorio de autoridades y directivos del centro regional.</p>
      <span class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-gold-700">
        Ver más
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="h-3 w-3"><path fill-rule="evenodd" d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z" clip-rule="evenodd" /></svg>
      </span>
    </a>

    <a href="/nosotros/organigrama" class="group light-card p-6">
      <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-gold-100 text-gold-600">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
          <path fill-rule="evenodd" d="M4.25 2A2.25 2.25 0 0 0 2 4.25v2.5A2.25 2.25 0 0 0 4.25 9h2.5A2.25 2.25 0 0 0 9 6.75v-2.5A2.25 2.25 0 0 0 6.75 2h-2.5Zm0 9A2.25 2.25 0 0 0 2 13.25v2.5A2.25 2.25 0 0 0 4.25 18h2.5A2.25 2.25 0 0 0 9 15.75v-2.5A2.25 2.25 0 0 0 6.75 11h-2.5Zm9-9A2.25 2.25 0 0 0 11 4.25v2.5A2.25 2.25 0 0 0 13.25 9h2.5A2.25 2.25 0 0 0 18 6.75v-2.5A2.25 2.25 0 0 0 15.75 2h-2.5Zm0 9A2.25 2.25 0 0 0 11 13.25v2.5A2.25 2.25 0 0 0 13.25 18h2.5A2.25 2.25 0 0 0 18 15.75v-2.5A2.25 2.25 0 0 0 15.75 11h-2.5Z" clip-rule="evenodd" />
        </svg>
      </div>
      <h3 class="font-bold text-green-900 group-hover:text-gold-700">Organigrama</h3>
      <p class="mt-1 text-sm text-gray-500">Estructura organizacional y jerarquía administrativa.</p>
      <span class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-gold-700">
        Ver más
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="h-3 w-3"><path fill-rule="evenodd" d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z" clip-rule="evenodd" /></svg>
      </span>
    </a>

    <a href="/nosotros/unidades" class="group light-card p-6">
      <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-gold-100 text-gold-600">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
          <path fill-rule="evenodd" d="M1 2.75A.75.75 0 0 1 1.75 2h16.5a.75.75 0 0 1 0 1.5H1.75A.75.75 0 0 1 1 2.75Zm0 4a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H1.75A.75.75 0 0 1 1 6.75ZM1.75 10a.75.75 0 0 0 0 1.5h16.5a.75.75 0 0 0 0-1.5H1.75Z" clip-rule="evenodd" />
        </svg>
      </div>
      <h3 class="font-bold text-green-900 group-hover:text-gold-700">Unidades</h3>
      <p class="mt-1 text-sm text-gray-500">EUS, ASP, CIDETE, UTTE, INESTEC e IMUP Veraguas.</p>
      <span class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-gold-700">
        Ver más
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="h-3 w-3"><path fill-rule="evenodd" d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z" clip-rule="evenodd" /></svg>
      </span>
    </a>

    <a href="/nosotros/infraestructura" class="group light-card p-6">
      <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-gold-100 text-gold-600">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
          <path fill-rule="evenodd" d="M4 16.5v-13h-.25a.75.75 0 0 1 0-1.5h12.5a.75.75 0 0 1 0 1.5H16v13h.25a.75.75 0 0 1 0 1.5h-3.5a.75.75 0 0 1-.75-.75v-2.5a.75.75 0 0 0-.75-.75h-2.5a.75.75 0 0 0-.75.75v2.5a.75.75 0 0 1-.75.75h-3.5a.75.75 0 0 1 0-1.5H4ZM7.5 11a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5H8a.5.5 0 0 1-.5-.5v-1Zm.5-4a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5H8Zm2.5 3.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1Zm.5-4a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1Z" clip-rule="evenodd" />
        </svg>
      </div>
      <h3 class="font-bold text-green-900 group-hover:text-gold-700">Infraestructura</h3>
      <p class="mt-1 text-sm text-gray-500">Campus, laboratorios, biblioteca e instalaciones del CRUV.</p>
      <span class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-gold-700">
        Ver más
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="h-3 w-3"><path fill-rule="evenodd" d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z" clip-rule="evenodd" /></svg>
      </span>
    </a>

    <a href="/nosotros/transparencia" class="group light-card p-6">
      <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-gold-100 text-gold-600">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
          <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z" clip-rule="evenodd" />
        </svg>
      </div>
      <h3 class="font-bold text-green-900 group-hover:text-gold-700">Transparencia</h3>
      <p class="mt-1 text-sm text-gray-500">Información pública, rendición de cuentas y documentos institucionales.</p>
      <span class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-gold-700">
        Ver más
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="h-3 w-3"><path fill-rule="evenodd" d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z" clip-rule="evenodd" /></svg>
      </span>
    </a>
  </div>
</SectionLayout>
