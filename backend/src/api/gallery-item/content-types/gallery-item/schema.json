{
  "kind": "collectionType",
  "collectionName": "gallery_items",
  "info": {
    "singularName": "gallery-item",
    "pluralName": "gallery-items",
    "displayName": "gallery-item"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "media": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Foto",
        "Video"
      ]
    },
    "album": {
      "type": "string"
    },
    "externalUrl": {
      "type": "string"
    }
  }
}
