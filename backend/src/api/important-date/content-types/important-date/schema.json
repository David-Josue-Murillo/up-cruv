{
  "kind": "collectionType",
  "collectionName": "important_dates",
  "info": {
    "singularName": "important-date",
    "pluralName": "important-dates",
    "displayName": "important-date"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "date": {
      "type": "datetime",
      "required": true
    },
    "endDate": {
      "type": "datetime",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Admisión",
        "Académico",
        "Administrativo",
        "Eventos"
      ]
    },
    "highlighted": {
      "type": "boolean"
    }
  }
}
