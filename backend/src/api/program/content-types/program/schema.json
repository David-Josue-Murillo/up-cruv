{
  "kind": "collectionType",
  "collectionName": "programs",
  "info": {
    "singularName": "program",
    "pluralName": "programs",
    "displayName": "program"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "code": {
      "type": "text",
      "unique": true
    },
    "description": {
      "type": "blocks"
    },
    "level": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Pregrado",
        "Postgrado",
        "Técnico",
        "Educación Continua"
      ]
    },
    "credits": {
      "type": "integer"
    },
    "duration": {
      "type": "string"
    },
    "modality": {
      "type": "enumeration",
      "enum": [
        "Presencia",
        "Virtual",
        "Híbrida"
      ]
    },
    "coordinator": {
      "type": "string"
    },
    "admissionRequirements": {
      "type": "blocks"
    },
    "curriculum": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "faculty": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::faculty.faculty"
    }
  }
}
